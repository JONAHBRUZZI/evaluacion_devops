# ============================================
# CONFIGURACIÓN DE ENTORNO - EVALUACIÓN DEVOPS
# ============================================
# COPIAR A .env y configurar valores reales

# ============ AWS / EC2 ============
AWS_REGION=us-east-1
EC2_PUBLIC_IP=

# ============ BASE DE DATOS ============
DB_ENDPOINT=localhost
DB_PORT=3306
DB_NAME=evaluation_devops
DB_USERNAME=root
DB_PASSWORD=tu_contraseña_segura_aqui

# ============ DOCKER HUB ============
DOCKERHUB_USERNAME=tu_usuario_dockerhub
DOCKERHUB_TOKEN=tu_token_dockerhub

# ============ SSH ============
EC2_SSH_KEY=~/.ssh/evaluation-devops-key.pem

# ============ PUERTOS (NO MODIFICAR) ============
FRONTEND_PORT=80
BACKEND_VENTAS_PORT=8080
BACKEND_DESPACHOS_PORT=8081